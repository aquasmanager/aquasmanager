# --- Accès ---------------------------------------------------------------
# Port HTTP de l'interface et adresse à laquelle tu l'ouvres dans le navigateur
AQUAS_HTTP_PORT=8080
AQUAS_PUBLIC_URL=http://192.168.1.10:8080
# Compte administrateur créé au premier démarrage (changement imposé à la première connexion)
AQUAS_DEFAULT_ADMIN_USERNAME=admin
AQUAS_DEFAULT_ADMIN_PASSWORD=ChangeMe123!
# true uniquement si l'interface est servie en HTTPS (proxy, Traefik, Caddy...)
AQUAS_AUTH__COOKIE_SECURE=false

# --- MQTT (broker fourni, utilisé par l'API et les ESP32) ------------------
AQUAS_MQTT__USER=aquasmanager
AQUAS_MQTT__PASSWORD=remplace-moi-par-un-mot-de-passe-long
# IP du serveur telle que la voient les ESP32 (celle de AQUAS_PUBLIC_URL)
AQUAS_MQTT__DEVICE_HOST=192.168.1.10
AQUAS_MQTT__TOPIC_PREFIX=aquarium

# --- Réseau des ESP32 (écrit dans leur firmware) ---------------------------
AQUAS_ESP__SSID=MonWifi
AQUAS_ESP__PASSWORD=mot-de-passe-wifi
AQUAS_NETWORK__GATEWAY=192.168.1.1
AQUAS_NETWORK__SUBNET=255.255.255.0
AQUAS_NETWORK__DNS1=192.168.1.1
# Plage d'IP fixes attribuées aux contrôleurs
AQUAS_NETWORK__START=192.168.1.50
AQUAS_NETWORK__END=192.168.1.99

# --- Divers ----------------------------------------------------------------
AQUAS_TIMEZONE=Europe/Paris
# Heure d'envoi du rappel des tâches du jour
AQUAS_TASK_REMINDER_HOUR=8
# Jours d'historique des capteurs conservés (0 = illimité)
AQUAS_SENSOR_READING_RETENTION_DAYS=365
# La clé de signature des sessions (AQUAS_SECRET_KEY) est générée
# automatiquement dans data/base/.secret_key si elle n'est pas fournie.
